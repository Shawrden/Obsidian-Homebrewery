{
  "name": "obsidian-homebrewery-exporter",
  "version": "0.1.1",
  "description": "Live D&D 5e book-style preview of Obsidian notes with vector PDF and Homebrewery V3 Markdown export.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "jest"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "homebrewery",
    "dnd",
    "5e"
  ],
  "license": "MIT",
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/ephesis": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.0",
    "jest": "^30.0.0",
    "obsidian": "latest",
    "ts-jest": "^29.4.0",
    "tslib": "^2.6.2",
    "typescript": "^5.5.0"
  }
}
